import tkinter as tk

city_map = [
    ["D", ".", ".", "E", "T"],
    [".", "E", ".", ".", "."],
    [".", ".", "P", ".", "."],
    [".", "E", ".", ".", "."],
    [".", ".", ".", ".", "S"],
]

health = 100
score = 0
pos = [0, 0]


def update_ui():
    lbl_health.config(text=f"Health: {health}")
    lbl_score.config(text=f"Score: {score}")
    for r in range(5):
        for c in range(5):
            val = city_map[r][c]
            color = {
                "D": "#2e7d32",
                "E": "#c62828",
                "T": "#f57f17",
                "P": "#6a1b9a",
                "S": "#0288d1",
                ".": "#1e2238",
            }.get(val, "#1e2238")
            grid_labels[(r, c)].config(text=val, bg=color)


def move(dr, dc):
    global health, score, pos
    nr, nc = pos[0] + dr, pos[1] + dc
    if 0 <= nr < 5 and 0 <= nc < 5:
        city_map[pos[0]][pos[1]] = "."
        tile = city_map[nr][nc]

        if tile == "E":
            health -= 20
        elif tile == "T":
            score += 100
        elif tile == "P":
            health += 20
        elif tile == "S":
            lbl_status.config(text="YOU WIN!")
            return

        pos = [nr, nc]
        city_map[nr][nc] = "D"
        update_ui()


root = tk.Tk()
root.title("Dragon City GUI")
root.configure(bg="#0f111a")

lbl_health = tk.Label(
    root,
    text=f"Health: {health}",
    fg="#4caf50",
    bg="#0f111a",
    font=("Helvetica", 12),
)
lbl_health.pack()
lbl_score = tk.Label(
    root, text=f"Score: {score}", fg="#ffb74d", bg="#0f111a", font=("Helvetica", 12)
)
lbl_score.pack()

frame = tk.Frame(root, bg="#0f111a")
frame.pack()

grid_labels = {}
for r in range(5):
    for c in range(5):
        lbl = tk.Label(
            frame,
            text=".",
            width=4,
            height=2,
            fg="white",
            font=("Helvetica", 12, "bold"),
        )
        lbl.grid(row=r, column=c, padx=2, pady=2)
        grid_labels[(r, c)] = lbl

btn_frame = tk.Frame(root, bg="#0f111a")
btn_frame.pack(pady=10)

tk.Button(
    btn_frame, text="↑", command=lambda: move(-1, 0), width=4, bg="#2a2d3d"
).grid(row=0, column=1)
tk.Button(
    btn_frame, text="←", command=lambda: move(0, -1), width=4, bg="#2a2d3d"
).grid(row=1, column=0)
tk.Button(
    btn_frame, text="↓", command=lambda: move(1, 0), width=4, bg="#2a2d3d"
).grid(row=1, column=1)
tk.Button(
    btn_frame, text="→", command=lambda: move(0, 1), width=4, bg="#2a2d3d"
).grid(row=1, column=2)

lbl_status = tk.Label(root, text="", fg="white", bg="#0f111a")
lbl_status.pack()

update_ui()
root.mainloop()
